<table <%= placeholder_table_styles %>>
  <tr>
    <%= placeholder_cell("20px", vertical: false) %>
  </tr>
</table>

<table <%= placeholder_table_styles(width: "100%", style: "width:100%;max-width:700px;") %>>
  <tr>
    <%= placeholder_cell("12px", vertical: true) %>
    <td>
      <%= render partial: "mailer/mailer_header",
                 locals: {
                   summary: I18n.t(:"mail.work_packages.assigned_by", user: @journal.user),
                   button_href: details_notifications_url(@work_package.id, tab: :summary),
                   button_text: I18n.t(:"mail.notification.view_work_package"),
                   user: @user
                 } %>

      <table>
        <tr>
          <%= placeholder_cell("40px", vertical: false) %>
        </tr>
      </table>

      <table>
        <tr>
          <%= render partial: "work_package_details", locals: { work_package: @work_package } %>
        <tr/>
        <tr>
          <%= format_text(
            t(:text_latest_note, note: last_work_package_note(@work_package)),
            only_path: false,
            object: @work_package,
            project: @work_package.project
          ) %>
        </tr>
      </table>

      <table>
        <tr>
          <%= placeholder_cell("40px", vertical: false) %>
        </tr>
      </table>
    </td>
    <%= placeholder_cell("12px", vertical: true) %>
  </tr>
</table>
